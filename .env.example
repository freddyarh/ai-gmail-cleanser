# OpenAI API key — required for Phase 2+ classification
OPENAI_API_KEY=sk-your-key-here

# Model to use for email classification
MODEL_NAME=gpt-4o-mini

# Number of unread emails to fetch and classify per run
MAX_EMAILS=10

# Phase 3 — safety defaults (recommended for first runs)
DRY_RUN=true
AUTO_CONFIRM=false
NEVER_AUTO_DELETE=true
ALLOW_LIVE_DELETE=false

# Gmail labels and action log
PENDING_DELETE_LABEL=AI/Pending Delete
REVIEW_LABEL=AI/Review
LOG_PATH=logs/actions.json
